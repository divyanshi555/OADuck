# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js session secret and Google OAuth credentials
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional email for initial admin-role promotion
AUTH_ADMIN_EMAIL=""

# Duck Insight (Gemini)
AI_API_KEY=""
DUCK_INSIGHT_MODEL="gemini-3.8-flash"

# Judge0 CE
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_AUTH_TOKEN=""

# Assessment settings
ASSESSMENT_MODE="NORMAL"
ASSESSMENT_DURATION_MINUTES="30"

# Public documentation link in the application
NEXT_PUBLIC_DOCS_URL="/docs/overview"

# Docusaurus build-time settings (optional)
APP_URL="http://localhost:3000"
DOCS_SITE_URL="http://localhost:3000"
